---
// Page d'un projet : une page générée par fiche de la collection « projets ».
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThemeIcon from "../../components/ThemeIcon.jsx";
import { Image } from "astro:assets";

// Au build : une page par fiche, triées par ordre d'affichage
export async function getStaticPaths() {
  const projets = (await getCollection("projets")).sort(
    (a, b) => a.data.ordre - b.data.ordre,
  );

  return projets.map((projet, index) => ({
    params: { id: projet.id },
    props: {
      projet,
      precedent: projets[index - 1],
      suivant: projets[index + 1],
    },
  }));
}

interface Props {
  projet: CollectionEntry<"projets">;
  precedent?: CollectionEntry<"projets">;
  suivant?: CollectionEntry<"projets">;
}

const { projet, precedent, suivant } = Astro.props;
const { Content } = await render(projet);
const {
  nom,
  titre,
  accroche,
  filtres,
  depot,
  site,
  estCeSite,
  kanban,
  image,
  imageAlt,
} = projet.data;
---

<BaseLayout
  title={`${nom} — Projet de formation | Thierry Pollastri`}
  description={accroche}
>
  <article class="project">
    <a class="project__back" href="/#projets">
      <span aria-hidden="true">←</span>
      <span class="project__label">Retour aux projets</span>
    </a>

    <header class="project__header">
      <h1>{titre}</h1>
      <p class="project__accroche">{accroche}</p>
    </header>

    <Image
      class="project__cover"
      src={image}
      alt={imageAlt}
      widths={[400, 800, 1200, 1600, 2000]}
      sizes="(min-width: 1024px) 64rem, 92vw"
      loading="eager"
      fetchpriority="high"
    />

    <div class="project__layout">
      <aside class="project__aside" aria-labelledby="en-bref">
        <h2 id="en-bref">En bref</h2>

        <dl>
          <dt>Cadre</dt>
          <dd>Formation OpenClassrooms, projet {projet.data.projet}</dd>
          <dt>Thèmes</dt>
          <dd>
            <ul class="project__tags" role="list">
              {
                filtres.map((filtre) => (
                  <li>
                    <ThemeIcon theme={filtre} />
                    {filtre}
                  </li>
                ))
              }
            </ul>
          </dd>
        </dl>

        <ul class="project__links" role="list">
          {
            site && (
              <li>
                {estCeSite ? (
                  // Ce site lui-même : même onglet, pas de mention « nouvel onglet »
                  <a href={site}>Voir le site</a>
                ) : (
                  <a href={site} target="_blank" rel="noopener">
                    Voir le site
                    <span class="visually-hidden"> {nom} (nouvel onglet)</span>
                  </a>
                )}
              </li>
            )
          }
          {
            depot && (
              <li>
                <a href={depot} target="_blank" rel="noopener">
                  Dépôt GitHub
                  <span class="visually-hidden"> de {nom} (nouvel onglet)</span>
                </a>
              </li>
            )
          }
          {
            kanban && (
              <li>
                <a href={kanban} target="_blank" rel="noopener">
                  Kanban Notion
                  <span class="visually-hidden"> de {nom} (nouvel onglet)</span>
                </a>
              </li>
            )
          }
        </ul>
      </aside>

      <div class="project__content">
        <Content />
      </div>
    </div>

    <nav class="project__pager" aria-label="Autres projets">
      {
        precedent && (
          <a href={`/projets/${precedent.id}/`} rel="prev">
            <span aria-hidden="true">←</span>
            <span class="project__label">
              <span class="visually-hidden">Projet précédent : </span>
              {precedent.data.nom}
            </span>
          </a>
        )
      }
      {
        suivant && (
          <a href={`/projets/${suivant.id}/`} rel="next">
            <span class="project__label">
              <span class="visually-hidden">Projet suivant : </span>
              {suivant.data.nom}
            </span>
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style lang="scss">
  @use "../../styles/variables" as *;

  .project {
    padding: var(--space-5) var(--page-inline) var(--space-7);
  }

  // Lien de retour, discret
  .project__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;

    &:hover {
      color: var(--text-color);
    }
  }

  .project__header {
    // max-width: 50rem;
    margin-block: var(--space-4) var(--space-6);

    h1 {
      font-family: var(--font-serif-condensed);
      font-stretch: var(--serif-width);
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      font-weight: 600;
      line-height: 1.1;
    }
  }

  .project__accroche {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-family: var(--font-serif-condensed);
    font-stretch: var(--serif-width);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-style: italic;
  }

  // Capture principale : cadre 16/10, largeur limitée pour rester lisible
  .project__cover {
    display: block;
    width: 100%;
    max-width: 64rem;
    height: auto;
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-6);
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  // « En bref » au-dessus du texte, puis à droite et collant sur desktop
  .project__layout {
    display: grid;
    gap: var(--space-6);

    @include from($bp-desktop) {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
  }

  .project__aside {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--card-bg);
    box-shadow: var(--shadow-card);

    h2 {
      margin-bottom: var(--space-3);
      font-size: 1.5rem;
    }

    @include from($bp-desktop) {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
      grid-column: 2;
      grid-row: 1;
    }
  }

  dl {
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  dt {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  dd {
    margin-bottom: var(--space-2);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;

    li {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      font-size: 0.85rem;
    }

    // Le SVG vient d'un composant enfant : il faut :global() pour l'atteindre
    :global(svg) {
      flex-shrink: 0;
      color: var(--accent);
    }
  }

  // Liens externes en boutons secondaires
  .project__links {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--text-color);
      border-radius: var(--radius-sm);
      color: inherit;
      font-weight: 500;
      text-decoration: none;
      transition:
        background-color var(--duration-base) ease,
        color var(--duration-base) ease;

      &:hover {
        background-color: var(--btn-hover-bg);
        color: var(--btn-hover-text);
      }
    }
  }

  // Texte de la fiche, produit par le Markdown : :global() pour l'atteindre
  .project__content {
    max-width: var(--measure);

    @include from($bp-desktop) {
      grid-column: 1;
      grid-row: 1;
    }

    > :global(* + *) {
      margin-top: var(--space-3);
    }

    :global(h2) {
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
      font-size: clamp(1.6rem, 3vw, 2.2rem);
    }

    :global(h2:first-child) {
      margin-top: 0;
    }

    :global(ul) {
      padding-left: var(--space-4);
    }

    :global(li + li) {
      margin-top: var(--space-1);
    }

    :global(table) {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    :global(th),
    :global(td) {
      padding: var(--space-2) var(--space-3);
      border-bottom: 1px solid var(--border);
      text-align: left;
    }

    :global(th) {
      font-weight: 600;
    }

    // Captures de preuve : le paragraphe qui ne contient que des images
    :global(p:has(> img)) {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    :global(img) {
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: 36rem; // limite les images hautes, comme le diagramme
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-card);
    }

    // Paire avant / après : deux figures légendées, côte à côte si la place le permet
    :global(.avant-apres) {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    :global(.avant-apres figure) {
      margin: 0;
    }

    :global(.avant-apres figcaption) {
      margin-bottom: var(--space-1);
      font-size: 0.9rem;
      font-weight: 600;
    }

    :global(.avant-apres p) {
      margin-top: 0;
    }

    :global(.avant-apres img) {
      height: 4.5rem; // même hauteur pour les deux jauges
    }

    // Légende : le paragraphe qui suit les images
    :global(.avant-apres + p),
    :global(p:has(> img) + p) {
      margin-top: var(--space-2);
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    :global(code) {
      padding: 0 var(--space-1);
      border-radius: 4px;
      background-color: var(--bg-alt);
      font-size: 0.9em;
    }
  }

  // Seul le texte des liens de navigation est souligné, pas les flèches
  .project__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  // Projet précédent / suivant
  .project__pager {
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);

    a {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      font-weight: 500;
      text-decoration: none;
    }

    a[rel="next"] {
      margin-left: auto; // reste à droite même sans lien « précédent »
    }
  }
</style>
